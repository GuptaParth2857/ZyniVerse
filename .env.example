# ─────────────────────────────────────────────────────────────────────────────
# ZyniVerse environment variables
# Copy to `.env` and fill in the values. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Database (Supabase Postgres) ────────────────────────────────────────────
# DATABASE_URL  = pooled connection (used by the app at runtime)
# DIRECT_URL    = direct connection (used by Prisma migrations)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<host>:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres"

# ── Auth (NextAuth) ─────────────────────────────────────────────────────────
AUTH_URL=http://localhost:3000
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# ── AI (Google Gemini) ──────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Payments (Stripe) ───────────────────────────────────────────────────────
# Without these, Premium/Merch checkout returns 503 "Stripe is not configured".
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_WEBHOOK_SECRET=

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=

# ── Media storage (Cloudflare R2) ───────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=

# ── Integrations ────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=
SIMKL_CLIENT_ID=
SIMKL_CLIENT_SECRET=
NEXT_PUBLIC_DISCORD_INVITE=
NEXT_PUBLIC_WS_URL=

# ── Push notifications (Web Push / VAPID) ───────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@zyverse.in

# ── Supabase client keys ────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Ops / cron ──────────────────────────────────────────────────────────────
CRON_SECRET=
INDEXNOW_KEY=
INGEST_TOKEN=
INGEST_OWNER_USERNAME=
AWARDS_WEBHOOK_SECRET=
DM_BROADCAST_TOKEN=
REDIS_URL=
NEXT_PUBLIC_GOOGLE_VERIFICATION=
