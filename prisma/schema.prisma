generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  directUrl    = env("DIRECT_URL")
  relationMode = "prisma"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String    @unique
  password      String?
  avatar        String?
  bio           String?
  banner        String?
  referralCode  String?   @unique
  referredBy    String?
  referralCount Int       @default(0)
  themeColor    String?   @default("emerald")
  signature     String?
  provider      String?
  onboarded     Boolean   @default(false)
  favoriteGenres String[] @default([])
  favoriteMoods  String[] @default([])
  lastSeen      DateTime?
  createdAt     DateTime  @default(now())

  entries                ListEntry[]
  listShares             ListShare[]
  progress               EpisodeProgress[]
  reviews                Review[]
  episodeThreadComments  EpisodeThreadComment[]
  dubRequests            DubRequest[]
  posts                  Post[]
  comments               Comment[]
  savedPosts             SavedPost[]
  notifications          Notification[]
  pushSubscriptions      PushSubscription[]
  activities             Activity[]
  followers              Follow[]                  @relation("Following")
  following              Follow[]                  @relation("Follower")
  apiKeys                ApiKey[]
  fillerVotes            FillerVote[]
  fillerReports          FillerReport[]
  subscription           Subscription?
  orders                 Order[]
  contentReports         ContentReport[]
  notificationPreference NotificationPreference?
  listImports            ListImport[]
  characterFavorites     CharacterFavorite[]
  mediaRecommendations   MediaRecommendation[]
  mediaRecommendationVotes MediaRecommendationVote[]
  episodeReactions       EpisodeReaction[]
  tierLists              TierList[]
  tierListVotes          TierListVote[]
  airingAlerts           AiringAlert[]
  mangaEntries           MangaEntry[]
  watchParties           WatchParty[]              @relation("Host")
  partyMembers           WatchPartyMember[]
  cosplays               Cosplay[]
  cosplayLikes           CosplayLike[]
  challenges             Challenge[]               @relation("Creator")
  challengeParticipants  ChallengeParticipant[]
  challengeEntries       ChallengeEntry[]
  lists                  UserList[]
  listLikes              UserListLike[]
  listVotes              ListVote[]
  forumThreads           ForumThread[]
  forumPosts             ForumPost[]
  forumVotes             ForumVote[]
  blogPosts              BlogPost[]
  blogLikes              BlogPostLike[]
  blogComments           BlogComment[]
  userAchievements       UserAchievement[]
  userPoints             UserPoints?
  clubs                  Club[]                    @relation("ClubOwner")
  clubMembers            ClubMember[]              @relation("ClubMembers")
  clubPosts              ClubPost[]                @relation("ClubPosts")
  clubJoinRequests       ClubJoinRequest[]         @relation("ClubJoinRequests")
  wikiEdits              WikiPage[]                @relation("WikiEditor")
  wikiHistory            WikiPageHistory[]         @relation("WikiHistoryEditor")
  conversations          ConversationParticipant[]
  messages               Message[]
  messageReactions       MessageReaction[]
  doujinshiEntries       DoujinshiEntry[]
  tagVotes               TagVote[]
  characterVotes         CharacterVote[]
  mangaChapterData       MangaChapterData[]
  polls                  Poll[]
  pollVotes              PollVote[]
  sentFriendRequests     FriendRequest[]           @relation("SentRequests")
  receivedFriendRequests FriendRequest[]           @relation("ReceivedRequests")
  ratings                Rating[]
  communityTags          CommunityTag[]
  tagVotes2              TagVote2[]
  activityReactions      ActivityReaction[]
  clubPostComments       ClubPostComment[]
  clubEventRsvps         ClubEventRSVP[]
  clubBans               ClubBan[]                 @relation("ClubBanned")
  clubBannedBy           ClubBan[]                 @relation("ClubBanner")
  zyniAwardVotes         ZyniAwardVote[]
  figureCollection       FigureCollection[]
  dailyLogin             DailyLogin?
  streakFreeze           StreakFreeze?
  coinWallet             CoinWallet?
  economyLedger          EconomyLedger[]
  aiConversation         AiConversation?
  animeFollows           AnimeFollow[]
  discordAccount         DiscordAccount?
  externalAccounts       ExternalAccount[]
  theoryVotes            TheoryVote[]
  pageViews              PageView[]
  sessions               UserSession[]
  searchLogs             SearchLog[]
  quizScores             QuizScore[]
  quizChallenger         QuizChallenge[]           @relation("QuizChallenger")
  quizChallengee         QuizChallenge[]           @relation("QuizChallengee")
  dubNotifications       DubNotification[]
  feedbackReplies        FeedbackReply[]
  feedbackLikes          FeedbackLike[]
  feedbackComments       FeedbackComment[]
  moments                Moment[]
  momentLikes            MomentLike[]
  reels                  Reel[]
  reelLikes              ReelLike[]
  reelComments           ReelComment[]
  reelReports            ReelReport[]
  clubReels              ClubReel[]
  clubReelLikes          ClubReelLike[]
  clubPolls              ClubPoll[]                @relation("ClubPollCreator")
  clubPollVotes          ClubPollVote[]
  voiceLineLikes         VoiceLineLike[]
  characterBattles       CharacterBattleVote[]
  characterTournaments   CharacterTournament[]     @relation("TournamentCreator")
  tournamentVotes        CharacterTournamentVote[]
  tournamentPollVotes    CharacterTournamentPollVote[]
  fanArts                FanArt[]
  fanArtLikes            FanArtLike[]
  longReviews            LongReview[]
  longReviewVotes        LongReviewVote[]
  wallpapers             Wallpaper[]
  wallpaperLikes         WallpaperLike[]
  bingoCards             BingoCard[]
  bingoTemplates         BingoTemplate[]       @relation("BingoTemplateCreator")
  ownedSharedWatchlists  SharedWatchlist[]      @relation("WatchlistOwner")
  sharedWatchlistMembers SharedWatchlistMember[]
  creatorProfile         CreatorProfile?
  tipsSent               Tip[]
  wordleGames            WordleGame[]
  userFrames             UserFrame[]
  webhooks               Webhook[]
  sceneClips             SceneClip[]
  sceneClipLikes         SceneClipLike[]
  commissions            Commission[]
  commissionRequests     CommissionRequest[]
  memes                  Meme[]
  memeVotes              MemeVote[]
  memeComments           MemeComment[]
  contestWins            ContentContest[]          @relation("ContestWinner")
  contestEntries         ContentContestEntry[]
  contestVotes           ContentContestVote[]
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model ListShare {
  id        String   @id @default(cuid())
  userId    String   @unique
  key       String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([key])
}

model ListEntry {
  id              String    @id @default(cuid())
  userId          String
  mediaId         Int
  type            String
  status          String    @default("PLANNING")
  progress        Int       @default(0)
  total           Int       @default(0)
  score           Int?
  scoreStory      Int?
  scoreArt        Int?
  scoreSound      Int?
  scoreCharacters Int?
  scoreEnjoyment  Int?
  dropReason      String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
  @@index([userId, status])
  @@index([status])
}

model EpisodeProgress {
  id        String   @id @default(cuid())
  userId    String
  mediaId   Int
  episode   Int
  title     String?
  watchedAt DateTime @default(now())
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId, episode])
  @@index([userId, mediaId])
  @@index([userId, watchedAt])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  mediaId   Int
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
}

model EpisodeThreadComment {
  id        String   @id @default(cuid())
  mediaId   Int
  episode   Int
  userId    String
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mediaId, episode])
  @@index([mediaId, createdAt])
}

model DubRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaId   Int
  title     String
  language  String
  createdAt DateTime @default(now())

  @@unique([userId, mediaId, language])
  @@index([language])
}

model Post {
  id        String      @id @default(cuid())
  userId    String
  author    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  type      String      @default("POST")
  mediaId   Int?
  rating    Int?
  image     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  savedBy   SavedPost[]
  comments  Comment[]

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  author    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([postId])
  @@index([userId])
}

model SavedPost {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Activity {
  id         String   @id @default(cuid())
  userId     String
  type       String
  mediaId    Int?
  mediaTitle String?
  mediaImage String?
  message    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user      User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions ActivityReaction[]

  @@index([userId, createdAt])
  @@index([createdAt])
}

// ── API Key Management ──
model ApiKey {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String    @unique
  name      String
  tier      String    @default("free") // free | pro | enterprise
  requests  Int       @default(0) // total requests made
  limit     Int       @default(100) // daily request limit
  lastUsed  DateTime?
  expiresAt DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  usageLogs ApiUsageLog[] @relation("ApiUsageLogs")

  @@index([key])
  @@index([userId])
}

// ── Filler Data Reports ──
model FillerReport {
  id        String   @id @default(cuid())
  mediaId   Int
  episode   Int
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String? // "wrong-type" | "wrong-order" | "spoiler" | "other"
  note      String? // free text explanation
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, mediaId, episode])
  @@index([mediaId, episode])
}

// ── Crowdsourced Filler Verification ──
model FillerVote {
  id        String   @id @default(cuid())
  mediaId   Int
  episode   Int
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vote      String // "canon" | "filler" | "mixed" | "anime-canon"
  createdAt DateTime @default(now())

  @@unique([userId, mediaId, episode])
  @@index([mediaId, episode])
}

// ── Premium Subscriptions (Stripe-ready) ──
model Subscription {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeId           String?   @unique // Stripe subscription ID
  stripePriceId      String?
  stripeCustomerId   String?
  plan               String    @default("free") // free | pro | enterprise
  status             String    @default("active") // active | canceled | past_due | incomplete
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model TierList {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items TierListItem[]
  votes TierListVote[]

  @@index([userId])
  @@index([isPublic, createdAt])
}

model TierListItem {
  id         String   @id @default(cuid())
  tierListId String
  tier       String
  mediaId    Int
  mediaTitle String
  mediaImage String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  tierList TierList @relation(fields: [tierListId], references: [id], onDelete: Cascade)

  @@unique([tierListId, mediaId])
  @@index([tierListId])
}

model TierListVote {
  id         String   @id @default(cuid())
  tierListId String
  userId     String
  vote       Int
  createdAt  DateTime @default(now())

  tierList TierList @relation(fields: [tierListId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tierListId, userId])
  @@index([tierListId])
}

model WatchParty {
  id          String    @id @default(cuid())
  hostId      String
  clubId      String?
  mediaId     Int
  mediaTitle  String
  mediaImage  String?
  coverImage  String?
  episode     Int       @default(1)
  status      String    @default("waiting")
  startTime   DateTime?
  videoUrl    String?
  videoType   String?   @default("external")
  isPlaying   Boolean   @default(false)
  playbackPos Float     @default(0)
  lastSyncAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  host    User               @relation("Host", fields: [hostId], references: [id], onDelete: Cascade)
  club    Club?              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  members WatchPartyMember[]

  @@index([status, createdAt])
  @@index([clubId])
}

model WatchPartyMember {
  id       String   @id @default(cuid())
  partyId  String
  userId   String
  role     String   @default("member")
  joinedAt DateTime @default(now())

  party WatchParty @relation(fields: [partyId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([partyId, userId])
  @@index([partyId])
}

model Poll {
  id          String    @id @default(cuid())
  title       String
  description String?
  createdById String
  isActive    Boolean   @default(true)
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  options   PollOption[]
  votes     PollVote[]

  @@index([isActive, createdAt])
}

model PollOption {
  id     String  @id @default(cuid())
  pollId String
  label  String
  image  String?

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
}

model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([pollId])
}

model FriendRequest {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sender   User @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
}

model Cosplay {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  character   String
  animeTitle  String
  animeId     Int?
  imageUrl    String
  tags        String   @default("")
  likes       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  likesRel CosplayLike[]

  @@index([animeId])
  @@index([userId])
  @@index([createdAt])
  @@index([likes])
  @@index([animeTitle, createdAt])
  @@index([character, createdAt])
}

model CosplayLike {
  id        String   @id @default(cuid())
  cosplayId String
  userId    String
  createdAt DateTime @default(now())

  cosplay Cosplay @relation(fields: [cosplayId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cosplayId, userId])
}

// ── API Usage Log ──
model ApiUsageLog {
  id        String   @id @default(cuid())
  keyId     String
  endpoint  String
  status    Int      @default(200)
  ip        String?
  timestamp DateTime @default(now())

  key ApiKey @relation("ApiUsageLogs", fields: [keyId], references: [id], onDelete: Cascade)

  @@index([keyId, timestamp])
  @@index([timestamp])
  @@index([keyId])
}

// ── Forum System ──
model ForumCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  threads ForumThread[]

  @@index([slug])
  @@index([sortOrder])
}

model ForumThread {
  id         String   @id @default(cuid())
  categoryId String?
  animeId    Int?
  animeTitle String?
  animeImage String?
  title      String
  slug       String   @unique
  content    String
  userId     String
  isPinned   Boolean  @default(false)
  isLocked   Boolean  @default(false)
  isDeleted  Boolean  @default(false)
  viewCount  Int      @default(0)
  postCount  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category ForumCategory? @relation(fields: [categoryId], references: [id])
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts    ForumPost[]
  votes    ForumVote[]

  @@index([categoryId, createdAt])
  @@index([animeId, createdAt])
  @@index([slug])
  @@index([userId])
}

model ForumPost {
  id        String   @id @default(cuid())
  threadId  String
  userId    String
  content   String
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thread ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes  ForumVote[] @relation("PostVotes")

  @@index([threadId, createdAt])
  @@index([userId])
}

model ForumVote {
  id       String  @id @default(cuid())
  postId   String?
  threadId String?
  userId   String
  vote     Int

  post   ForumPost?   @relation("PostVotes", fields: [postId], references: [id], onDelete: Cascade)
  thread ForumThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@unique([threadId, userId])
}

model AdImpression {
  id        String   @id @default(cuid())
  placement String
  page      String
  userId    String?
  createdAt DateTime @default(now())

  @@index([placement, createdAt])
  @@index([createdAt])
}

model AdClick {
  id        String   @id @default(cuid())
  placement String
  page      String
  userId    String?
  createdAt DateTime @default(now())

  @@index([placement, createdAt])
}

model AdConfig {
  id         String   @id
  type       String
  network    String
  code       String
  location   String
  isActive   Boolean  @default(true)
  width      Int?
  height     Int?
  renderMode String?
  updatedAt  DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // AIRING | FOLLOW | REVIEW | COMMENT | IMPORT | SYSTEM
  title     String
  body      String?
  link      String? // deep link
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AiCache {
  id        String   @id @default(cuid())
  key       String   @unique
  kind      String // chat | identify | vibe
  response  String
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

/// Postgres-copy of the semantic index in `AiCache`, stored as real vectors so a
/// query is answered with a pgvector index scan instead of shipping the whole
/// corpus to the JS runtime. A pure projection of `AiCache`: rebuilt by
/// `syncPgvectorNow()` and only reachable after the
/// `20261009090000_add_doc_embedding` migration (which also creates the `vector`
/// extension) is applied. The `embedding` column is `Unsupported` because Prisma
/// has no native vector type - all reads/writes go through `$queryRaw`.
model DocEmbedding {
  source    String
  docId     String
  title     String
  href      String
  snippet   String
  tags      String   @default("")
  model     String
  dims      Int
  embedding Unsupported("vector(768)")?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([source, docId])
}

model AiUsageDaily {
  id     String @id @default(cuid())
  day    String // YYYY-MM-DD (UTC)
  userId String // real userId or "__global__"
  count  Int    @default(0)

  @@unique([day, userId])
}

/// One rolling conversation per user is the concierge's memory. Keeping it a
/// single thread (rather than many named sessions) matches the command palette,
/// where "Zyni AI" is one assistant you keep talking to. `summary` is reserved
/// for a future compacted digest so history can be trimmed without losing the
/// gist; today the recent `messages` are replayed as model turns.
model AiConversation {
  id        String   @id @default(cuid())
  userId    String   @unique
  summary   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]
}

/// A single turn. `role` is Gemini's vocabulary ("user" | "model"). `href` is
/// only ever set after the route validated it against the viewer's allowed page
/// list, so a persisted link is safe to replay without re-checking.
model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // "user" | "model"
  text           String
  href           String?
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model ThemeSong {
  id           String   @id @default(cuid())
  mediaId      Int
  type         String // "OP" or "ED"
  sequence     Int // 1, 2, 3...
  title        String
  artist       String
  composer     String?
  episodeStart Int?
  episodeEnd   Int?
  youtubeId    String?
  createdAt    DateTime @default(now())

  @@unique([mediaId, type, sequence])
  @@index([mediaId])
}

model AnimeEpisode {
  id        String   @id @default(cuid())
  mediaId   Int
  episode   Int
  title     String?
  titleJp   String?
  airdate   String?
  runtime   Int?
  duration  Int?
  createdAt DateTime @default(now())

  @@unique([mediaId, episode])
  @@index([mediaId])
}

model Challenge {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String // "watch" | "read" | "mixed" | "custom"
  period      String // "yearly" | "seasonal" | "monthly" | "custom"
  year        Int?
  season      String? // "winter" | "spring" | "summer" | "fall"
  startDate   DateTime
  endDate     DateTime
  goalCount   Int // target number of anime/manga
  isPublic    Boolean  @default(true)
  createdBy   String?
  coverImage  String?
  rules       String? // markdown rules text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator      User?                  @relation("Creator", fields: [createdBy], references: [id])
  participants ChallengeParticipant[]
  entries      ChallengeEntry[]

  @@index([type, period, year])
  @@index([isPublic, startDate])
}

model ChallengeParticipant {
  id          String    @id @default(cuid())
  challengeId String
  userId      String
  progress    Int       @default(0) // anime/manga completed so far
  goalCount   Int // personal goal (can override challenge default)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([challengeId])
  @@index([userId])
}

model ChallengeEntry {
  id           String   @id @default(cuid())
  challengeId  String
  userId       String
  mediaId      Int
  mediaTitle   String
  mediaImage   String?
  mediaType    String // "anime" | "manga"
  episodeCount Int? // for anime
  chapterCount Int? // for manga
  completedAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId, mediaId])
  @@index([challengeId, userId])
}

model UserList {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  type        String // "anime" | "manga" | "mixed"
  category    String   @default("")
  isPublic    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  sortOrder   Int      @default(0)
  likes       Int      @default(0)
  upvotes     Int      @default(0)
  downvotes   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     UserListItem[]
  likesRel  UserListLike[]
  votes     ListVote[]

  @@index([userId])
  @@index([isPublic, createdAt])
  @@index([isFeatured])
}

model UserListItem {
  id         String   @id @default(cuid())
  listId     String
  mediaId    Int
  mediaTitle String
  mediaImage String?
  mediaType  String // "anime" | "manga"
  note       String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  list UserList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, mediaId])
  @@index([listId])
}

model UserListLike {
  id        String   @id @default(cuid())
  listId    String
  userId    String
  createdAt DateTime @default(now())

  list UserList @relation(fields: [listId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
}

model ListVote {
  id        String   @id @default(cuid())
  listId    String
  userId    String
  value     Int
  createdAt DateTime @default(now())

  list UserList @relation(fields: [listId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
}

model Club {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  rules       String?
  coverImage  String?
  icon        String?
  category    String
  isPrivate   Boolean  @default(false)
  ownerId     String
  memberCount Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner        User              @relation("ClubOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members      ClubMember[]
  posts        ClubPost[]
  joinRequests ClubJoinRequest[]
  events       ClubEvent[]
  bans         ClubBan[]
  reels        ClubReel[]
  polls        ClubPoll[]
  watchParties WatchParty[]

  @@index([slug])
  @@index([category, memberCount])
}

model ClubMember {
  id       String   @id @default(cuid())
  clubId   String
  userId   String
  role     String   @default("member")
  points   Int      @default(0)
  joinedAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation("ClubMembers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([clubId])
  @@index([userId])
}

model ClubPost {
  id           String   @id @default(cuid())
  clubId       String
  userId       String
  title        String
  content      String
  image        String?
  videoUrl     String?
  thumbnailUrl String?
  isPinned     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  club     Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user     User              @relation("ClubPosts", fields: [userId], references: [id], onDelete: Cascade)
  comments ClubPostComment[]

  @@index([clubId, createdAt])
}

model ClubJoinRequest {
  id        String   @id @default(cuid())
  clubId    String
  userId    String
  status    String   @default("pending")
  createdAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation("ClubJoinRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
}

model WikiPage {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  content      String
  summary      String?
  category     String
  tags         String   @default("")
  coverImage   String?
  isPublished  Boolean  @default(true)
  version      Int      @default(1)
  lastEditorId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  editor  User?             @relation("WikiEditor", fields: [lastEditorId], references: [id], onDelete: SetNull)
  history WikiPageHistory[]

  @@index([slug])
  @@index([category])
}

model WikiPageHistory {
  id        String   @id @default(cuid())
  pageId    String
  editorId  String?
  version   Int
  title     String
  content   String
  summary   String?
  createdAt DateTime @default(now())

  page   WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  editor User?    @relation("WikiHistoryEditor", fields: [editorId], references: [id], onDelete: SetNull)

  @@index([pageId, version])
}

// ── Chat / Direct Messages ──
model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime @default(now())
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  replyToId      String?
  deletedFor     String   @default("")
  isDeleted      Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?          @relation("MessageReply", fields: [replyToId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replies      Message[]         @relation("MessageReply")
  reactions    MessageReaction[]

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model AiringAlert {
  id        String   @id @default(cuid())
  userId    String
  mediaId   Int
  episode   Int
  airingAt  DateTime
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId, episode])
  @@index([userId])
  @@index([airingAt])
}

model MangaEntry {
  id            String    @id @default(cuid())
  userId        String
  mediaId       Int
  title         String
  coverImage    String?
  subType       String    @default("manga") // "manga" | "light_novel" | "manhwa" | "manhua"
  status        String // READING | COMPLETED | PLANNING | DROPPED | PAUSED | REREADING
  chapters      Int       @default(0)
  volumes       Int       @default(0)
  totalChapters Int?
  totalVolumes  Int?
  score         Int?
  mangaDexId    String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterReads MangaChapter[]

  @@unique([userId, mediaId])
  @@index([userId])
  @@index([userId, status])
}

model MangaChapter {
  id        String    @id @default(cuid())
  entryId   String
  chapter   Int
  title     String?
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  entry MangaEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, chapter])
  @@index([entryId])
}

model MangaDexCache {
  mediaId    Int       @id
  mangaDexId String
  title      String
  updatedAt  DateTime  @updatedAt

  @@index([mangaDexId])
}

// ── Achievements & Badges ──
model Achievement {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String
  icon        String // emoji or SVG path
  category    String // "watching" | "reading" | "community" | "social" | "milestone" | "special"
  criteria    String // JSON describing how to earn it
  points      Int      @default(0)
  isHidden    Boolean  @default(false)
  createdAt   DateTime @default(now())

  awards UserAchievement[]

  @@index([category])
  @@index([code])
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())
  progress      Int? // progress toward achievement (0-100)
  metadata      String? // JSON with context (anime title, etc.)

  achievement Achievement @relation(fields: [achievementId], references: [id])
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

model UserPoints {
  id        String   @id @default(cuid())
  userId    String   @unique
  points    Int      @default(0)
  level     Int      @default(1)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AffiliateClick {
  id        String   @id @default(cuid())
  partner   String
  page      String
  userId    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([partner, createdAt])
  @@index([createdAt])
}

model BlogPost {
  id          String    @id @default(cuid())
  userId      String
  title       String
  slug        String    @unique
  content     String
  excerpt     String?
  coverImage  String?
  tags        String    @default("")
  isDraft     Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  viewCount   Int       @default(0)
  likeCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes    BlogPostLike[]
  comments BlogComment[]

  @@index([userId, createdAt])
  @@index([isDraft, publishedAt])
  @@index([slug])
}

model BlogPostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model BlogComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model Doujinshi {
  id           String   @id @default(cuid())
  title        String
  circle       String?
  artist       String?
  parody       String?
  tags         String   @default("")
  description  String?
  coverUrl     String?
  pages        Int?
  language     String   @default("japanese")
  isTranslated Boolean  @default(false)
  externalUrl  String?
  addedBy      String?
  isApproved   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entries DoujinshiEntry[]

  @@index([parody])
  @@index([tags])
}

model DoujinshiEntry {
  id          String   @id @default(cuid())
  doujinshiId String
  userId      String
  status      String
  pagesRead   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doujinshi Doujinshi @relation(fields: [doujinshiId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([doujinshiId, userId])
}

model TagVote {
  id        String   @id @default(cuid())
  userId    String
  mediaId   Int
  tag       String
  vote      Int      @default(1)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId, tag])
  @@index([mediaId, tag])
}

model CharacterVote {
  id          String   @id @default(cuid())
  userId      String
  mediaId     Int
  characterId Int
  vote        Int      @default(1)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
  @@index([mediaId, characterId])
}

model MangaChapterData {
  id            String    @id @default(cuid())
  mangaId       Int
  chapterNumber Int
  title         String?
  volume        Int?
  pages         Int?
  publishedAt   DateTime?
  externalId    String?
  createdAt     DateTime  @default(now())

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  @@unique([mangaId, chapterNumber])
  @@index([mangaId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

model Feedback {
  id                  String   @id @default(cuid())
  type                String
  message             String
  page                String?
  email               String?
  userId              String?
  userAgent           String?
  status              String   @default("pending")
  isFeatured          Boolean  @default(false)
  featuredHeading     String?
  featuredDescription String?
  featuredImage       String?
  likeCount           Int      @default(0)
  replyCount          Int      @default(0)
  createdAt           DateTime @default(now())

  replies  FeedbackReply[]
  likes    FeedbackLike[]
  comments FeedbackComment[]

  @@index([createdAt])
  @@index([type])
  @@index([isFeatured])
}

model FeedbackReply {
  id         String   @id @default(cuid())
  feedbackId String
  userId     String
  message    String
  createdAt  DateTime @default(now())

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
}

model FeedbackLike {
  id         String   @id @default(cuid())
  feedbackId String
  userId     String
  createdAt  DateTime @default(now())

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, userId])
}

model FeedbackComment {
  id         String   @id @default(cuid())
  feedbackId String
  userId     String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
}

model UserActivity {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  mediaId   Int?
  query     String?
  genres    String[]
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([mediaId])
}

// ── Feature 1: ZyniVerse Community Score ──
model Rating {
  id         String   @id @default(cuid())
  userId     String
  mediaId    Int
  rating     Float
  weight     Float    @default(1.0)
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
  @@index([mediaId])
}

model ZyniScore {
  id            String   @id @default(cuid())
  mediaId       Int      @unique
  weightedScore Float    @default(0)
  bayesianScore Float    @default(0)
  totalVotes    Int      @default(0)
  verifiedVotes Int      @default(0)
  sumRatings    Float    @default(0)
  updatedAt     DateTime @updatedAt
}

// ── Feature 3: Community Tag System ──
model CommunityTag {
  id         String   @id @default(cuid())
  mediaId    Int
  tag        String
  upvotes    Int      @default(0)
  downvotes  Int      @default(0)
  score      Float    @default(0)
  isApproved Boolean  @default(true)
  createdBy  String
  createdAt  DateTime @default(now())

  votes   TagVote2[] @relation("TagVotes")
  creator User       @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@unique([mediaId, tag])
  @@index([mediaId, score])
}

model TagVote2 {
  id             String   @id @default(cuid())
  userId         String
  communityTagId String
  vote           Int
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  communityTag CommunityTag @relation("TagVotes", fields: [communityTagId], references: [id], onDelete: Cascade)

  @@unique([userId, communityTagId])
}

// ── Feature 4: Social Feed Reactions ──
model ActivityReaction {
  id         String   @id @default(cuid())
  userId     String
  activityId String
  type       String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([userId, activityId, type])
  @@index([activityId])
}

// ── Feature 6: Club Enhancements ──
model ClubPostComment {
  id         String   @id @default(cuid())
  clubPostId String
  userId     String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubPost ClubPost @relation(fields: [clubPostId], references: [id], onDelete: Cascade)

  @@index([clubPostId, createdAt])
}

model ClubEvent {
  id          String    @id @default(cuid())
  clubId      String
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime?
  isVirtual   Boolean   @default(false)
  streamUrl   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  club    Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  members ClubEventRSVP[]

  @@index([clubId, startTime])
}

model ClubEventRSVP {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  status    String
  createdAt DateTime @default(now())

  event ClubEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model ClubBan {
  id        String   @id @default(cuid())
  clubId    String
  userId    String
  bannedBy  String
  reason    String?
  createdAt DateTime @default(now())

  club   Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user   User @relation("ClubBanned", fields: [userId], references: [id], onDelete: Cascade)
  banner User @relation("ClubBanner", fields: [bannedBy], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
}

// ── Club Reels (short video feed inside clubs) ──
model ClubReel {
  id           String   @id @default(cuid())
  clubId       String
  userId       String
  videoUrl     String
  thumbnailUrl String?
  caption      String?
  views        Int      @default(0)
  createdAt    DateTime @default(now())

  club  Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes ClubReelLike[]

  @@index([clubId, createdAt])
  @@index([userId])
}

model ClubReelLike {
  id        String   @id @default(cuid())
  reelId    String
  userId    String
  createdAt DateTime @default(now())

  reel ClubReel @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reelId, userId])
  @@index([reelId])
}

// ── Club Polls (member voting) ──
model ClubPoll {
  id          String    @id @default(cuid())
  clubId      String
  title       String
  description String?
  createdById String
  isActive    Boolean   @default(true)
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  club         Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy    User             @relation("ClubPollCreator", fields: [createdById], references: [id], onDelete: Cascade)
  options      ClubPollOption[]
  ClubPollVote ClubPollVote[]

  @@index([clubId, createdAt])
}

model ClubPollOption {
  id     String @id @default(cuid())
  pollId String
  label  String

  poll  ClubPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes ClubPollVote[]

  @@index([pollId])
}

model ClubPollVote {
  id        String   @id @default(cuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  poll   ClubPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option ClubPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([pollId])
}

// ── Feature 8: Discord Integration ──
model DiscordAccount {
  id            String   @id @default(cuid())
  userId        String   @unique
  discordId     String   @unique
  username      String
  discriminator String?
  avatar        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExternalAccount {
  id           String    @id @default(cuid())
  userId       String
  provider     String
  providerId   String
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  syncAt       DateTime?
  lastSyncData Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
}

// ── Zyni AI Lab: fan-theory agreement votes ──
model TheoryVote {
  id        String   @id @default(cuid())
  mediaId   Int
  userId    String
  agree     Boolean
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mediaId, userId])
  @@index([mediaId])
}

// ── Feature 9: ZyniVerse Awards & Bracket Tournaments ──
model ZyniAward {
  id          String   @id @default(cuid())
  year        Int
  category    String
  title       String
  description String?
  status      String   @default("nominating")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  nominees ZyniAwardNominee[]
  votes    ZyniAwardVote[]

  @@unique([year, category])
  @@index([year, status])
}

model ZyniAwardNominee {
  id       String  @id @default(cuid())
  awardId  String
  mediaId  Int
  title    String
  image    String?
  round    Int     @default(1)
  seed     Int?
  advanced Boolean @default(false)

  award ZyniAward       @relation(fields: [awardId], references: [id], onDelete: Cascade)
  votes ZyniAwardVote[]

  @@index([awardId, round])
}

model ZyniAwardVote {
  id           String   @id @default(cuid())
  awardId      String
  nomineeId    String
  userId       String
  round        Int      @default(2)
  bracketMatch String?
  createdAt    DateTime @default(now())

  award   ZyniAward        @relation(fields: [awardId], references: [id], onDelete: Cascade)
  nominee ZyniAwardNominee @relation(fields: [nomineeId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([awardId, userId, round])
  @@index([nomineeId])
}

// ── Feature 10: Figure/Merch Collection Tracking ──
model FigureCollection {
  id           String    @id @default(cuid())
  userId       String
  name         String
  anime        String?
  manufacturer String?
  scale        String?
  price        Float?
  currency     String    @default("INR")
  purchaseDate DateTime?
  image        String?
  condition    String    @default("new")
  isForSale    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([anime])
}

// ── Analytics & Retention Infrastructure ──
model PageView {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String?
  path      String
  referrer  String?
  duration  Int?
  userAgent String?
  country   String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([path, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String?
  sessionId    String   @unique
  startedAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  device       String?
  browser      String?
  os           String?
  country      String?
  pagesViewed  Int      @default(1)
  isActive     Boolean  @default(true)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([sessionId])
  @@index([startedAt])
}

model SearchLog {
  id           String   @id @default(cuid())
  userId       String?
  query        String
  source       String   @default("search")
  resultsCount Int      @default(0)
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([query])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model RetentionMetric {
  id                 String   @id @default(cuid())
  date               DateTime @unique
  dau                Int      @default(0)
  wau                Int      @default(0)
  mau                Int      @default(0)
  newUsers           Int      @default(0)
  returningUsers     Int      @default(0)
  avgSessionMinutes  Float    @default(0)
  avgPagesPerSession Float    @default(0)
  createdAt          DateTime @default(now())

  @@index([date])
}

// ── Quiz Server-Side Persistence ──
model QuizScore {
  id             String   @id @default(cuid())
  userId         String
  category       String
  difficulty     String
  score          Int
  totalQuestions Int
  timeTaken      Int?
  xpEarned       Int      @default(0)
  isDaily        Boolean  @default(false)
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([category, score])
  @@index([createdAt])
}

model QuizChallenge {
  id              String   @id @default(cuid())
  challengerId    String
  challengeeId    String
  category        String
  difficulty      String
  status          String   @default("pending")
  challengerScore Int?
  challengeeScore Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  challenger User @relation("QuizChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  challengee User @relation("QuizChallengee", fields: [challengeeId], references: [id], onDelete: Cascade)

  @@index([challengerId])
  @@index([challengeeId])
  @@index([status])
}

// ── Indian Dub Notifications ──
model DubNotification {
  id             String    @id @default(cuid())
  userId         String
  malId          Int
  language       String
  active         Boolean   @default(true)
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, malId, language])
  @@index([userId])
  @@index([malId, language])
}

// ── EPG Cache ──
model EpgCache {
  id        String   @id @default(cuid())
  channelId String
  data      Json
  updatedAt DateTime @updatedAt

  @@unique([channelId])
  @@index([channelId])
}

// ── AniList Last-Good Response Cache ──
// Persists successful AniList GraphQL responses so the site can keep
// serving previously-fetched data when AniList is down/unreachable.
model AniListCache {
  key       String   @id // sha256(query + variables)
  data      Json
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

// ── YouTube Podcast Response Cache ──
// Persists successful YouTube podcast results so the site keeps serving
// them when the daily Search quota is exhausted, and avoids burning the
// quota on every request.
model PodcastCache {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

// ── External Awards (scraped from Crunchyroll, MAL, ANN, etc.) ──
model ExternalAward {
  id        Int      @id @default(autoincrement())
  year      Int
  category  String
  winner    String
  malId     Int?
  anilistId Int?
  image     String?
  platform  String
  type      String
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, category, platform, winner])
  @@index([year])
  @@index([platform])
  @@index([type])
}

// ── Conventions / Events ──
model Convention {
  id                  String   @id @default(cuid())
  name                String
  shortName           String?
  city                String
  state               String
  venue               String
  startDate           DateTime
  endDate             DateTime
  website             String
  ticketUrl           String?
  image               String?
  description         String
  estimatedAttendance Int?
  status              String   @default("upcoming") // upcoming | ongoing | past | cancelled
  organizers          String[]
  tags                String[]
  isPublic            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status])
  @@index([city])
  @@index([state])
  @@index([startDate])
  @@index([isPublic, startDate])
}

// ── Anime Events (curated global events) ──
model AnimeEvent {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  shortName   String
  type        String // expo | convention | stream | festival | premiere
  location    String
  country     String
  startDate   DateTime
  endDate     DateTime
  website     String
  image       String?
  description String
  status      String   @default("upcoming") // upcoming | ongoing | past
  attendance  Int?
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  announcements AnimeAnnouncement[]

  @@index([slug])
  @@index([status])
  @@index([type])
  @@index([startDate])
}

model AnimeAnnouncement {
  id          String   @id @default(cuid())
  eventId     String
  title       String
  description String
  category    String // anime-reveal | season-announcement | movie-reveal | game-reveal | collab | trailer | key-visual | casting | merchandise | other
  trailerUrl  String?
  posterUrl   String?
  sourceUrl   String?
  animeId     Int?
  createdAt   DateTime @default(now())

  event AnimeEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([category])
}

model Moment {
  id         String   @id @default(cuid())
  userId     String?
  animeId    Int
  animeTitle String
  animeCover String?
  quote      String
  character  String
  episode    String?
  timestamp  String?
  style      String   @default("classic")
  likesCount Int      @default(0)
  viewsCount Int      @default(0)
  isPublic   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes MomentLike[]

  @@index([userId])
  @@index([animeId])
  @@index([createdAt])
}

model MomentLike {
  id        String   @id @default(cuid())
  userId    String
  momentId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)

  @@unique([userId, momentId])
  @@index([momentId])
}

model Reel {
  id           String   @id @default(cuid())
  userId       String
  videoUrl     String
  thumbnailUrl String?
  caption      String?
  duration     Int      @default(0)
  views        Int      @default(0)
  animeId      Int?
  animeTitle   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     ReelLike[]
  comments  ReelComment[]
  reports   ReelReport[]
  reelViews ReelView[]

  @@index([userId])
  @@index([createdAt])
  @@index([animeId])
}

model ReelView {
  id        String   @id @default(cuid())
  reelId    String
  viewerKey String
  userId    String?
  createdAt DateTime @default(now())

  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@unique([reelId, viewerKey])
  @@index([reelId])
}

model ReelLike {
  id        String   @id @default(cuid())
  userId    String
  reelId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@unique([userId, reelId])
  @@index([reelId])
}

model ReelComment {
  id        String   @id @default(cuid())
  reelId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reelId])
  @@index([userId])
}

model ReelReport {
  id        String   @id @default(cuid())
  reelId    String
  userId    String
  reason    String
  createdAt DateTime @default(now())

  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reelId])
  @@index([reelId])
}

model VoiceLine {
  id         String          @id
  likesCount Int             @default(0)
  likes      VoiceLineLike[]

  @@index([likesCount])
}

model VoiceLineLike {
  id        String   @id @default(cuid())
  lineId    String
  userId    String
  createdAt DateTime @default(now())

  line VoiceLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lineId, userId])
  @@index([lineId])
}

// ── Character Battle (Daily Matchup) ──

model CharacterBattle {
  id         String   @id @default(cuid())
  date       DateTime @unique @default(now())
  charAId    Int
  charBId    Int
  charAName  String
  charBName  String
  charAImage String?
  charBImage String?
  votesA     Int      @default(0)
  votesB     Int      @default(0)
  totalVotes Int      @default(0)
  createdAt  DateTime @default(now())

  votes CharacterBattleVote[]

  @@index([date])
}

model CharacterBattleVote {
  id        String   @id @default(cuid())
  battleId  String
  userId    String
  choice    String
  createdAt DateTime @default(now())

  battle CharacterBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([battleId, userId])
  @@index([battleId])
}

// ── Character Tournaments (user-created) ──

model CharacterTournament {
  id          String              @id @default(cuid())
  creatorId   String
  title       String
  description String?
  posterUrl   String?
  size        Int                 @default(16)
  status      String              @default("upcoming") // qualifying | upcoming | active | completed | cancelled
  mode        String              @default("bracket") // qualifying | bracket
  bracketSize Int                 @default(16) // final single-elim bracket size for qualifying tournaments
  currentRound Int                @default(1)
  totalRounds Int
  seed        Int
  qualifyingStartedAt DateTime?
  qualifyingEndsAt   DateTime?
  bracketStartedAt   DateTime?
  roundEndsAt         DateTime?
  createdAt   DateTime            @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  creator      User                     @relation("TournamentCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  participants CharacterTournamentParticipant[]
  matches      CharacterTournamentMatch[]
  pollVotes    CharacterTournamentPollVote[]

  @@index([creatorId])
  @@index([status])
  @@index([mode])
}

model CharacterTournamentParticipant {
  id           String   @id @default(cuid())
  tournamentId String
  charId       Int
  charName     String
  charImage    String?
  franchiseCover String?
  seed         Int
  pollVotes    Int      @default(0)
  createdAt    DateTime @default(now())

  tournament      CharacterTournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matchA          CharacterTournamentMatch[]      @relation("MatchA")
  matchB          CharacterTournamentMatch[]      @relation("MatchB")
  wins            CharacterTournamentMatch[]      @relation("MatchWinner")
  pollVoteRecords CharacterTournamentPollVote[]

  @@index([tournamentId])
  @@unique([tournamentId, seed])
}

model CharacterTournamentPollVote {
  id            String   @id @default(cuid())
  tournamentId  String
  participantId String
  userId        String?
  deviceId      String?
  createdAt     DateTime @default(now())

  tournament  CharacterTournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  participant CharacterTournamentParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  user        User?                          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@unique([tournamentId, deviceId])
  @@index([tournamentId, participantId])
}

model CharacterTournamentMatch {
  id           String   @id @default(cuid())
  tournamentId String
  round        Int
  position     Int
  charAId      String?
  charBId      String?
  winnerId     String?
  votesA       Int      @default(0)
  votesB       Int      @default(0)
  createdAt    DateTime @default(now())

  tournament CharacterTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  charA      CharacterTournamentParticipant? @relation("MatchA", fields: [charAId], references: [id], onDelete: SetNull)
  charB      CharacterTournamentParticipant? @relation("MatchB", fields: [charBId], references: [id], onDelete: SetNull)
  winner     CharacterTournamentParticipant? @relation("MatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  votes      CharacterTournamentVote[]

  @@index([tournamentId, round, position])
}

model CharacterTournamentVote {
  id        String   @id @default(cuid())
  matchId   String
  // A voter is identified by their account or, for guests, by an anonymous
  // device id — same shape as CharacterTournamentPollVote. Login is not
  // required to vote, so userId must stay optional.
  userId    String?
  deviceId  String?
  choice    String
  createdAt DateTime @default(now())

  match CharacterTournamentMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User?                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@unique([matchId, deviceId])
  @@index([matchId])
  @@index([deviceId])
}

// ── Fan Art Gallery ──

model FanArt {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  animeTitle  String?
  animeId     Int?
  character   String?
  imageUrl    String
  artType     String   @default("digital")
  tags        String   @default("")
  likes       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  likesRel FanArtLike[]

  @@index([userId])
  @@index([createdAt])
  @@index([likes])
  @@index([artType])
}

model FanArtLike {
  id        String   @id @default(cuid())
  fanArtId  String
  userId    String
  createdAt DateTime @default(now())

  fanArt FanArt @relation(fields: [fanArtId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([fanArtId, userId])
  @@index([fanArtId])
}

// ── Long-form Reviews ──

model LongReview {
  id         String   @id @default(cuid())
  userId     String
  mediaId    Int
  mediaTitle String
  mediaImage String?
  title      String
  content    String
  rating     Int?
  upvotes    Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes   LongReviewVote[]

  @@index([userId])
  @@index([mediaId])
  @@index([upvotes])
  @@index([createdAt])
}

model LongReviewVote {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  value     Int      // 1 or -1
  createdAt DateTime @default(now())

  review LongReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
}

// ── Wallpaper Section ──

model Wallpaper {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  imageUrl    String
  thumbnailUrl String?
  animeTitle  String?
  animeId     Int?
  resolution  String?  // "1920x1080", "3840x2160", etc.
  category    String   @default("landscape") // landscape, portrait, phone, square
  tags        String   @default("")
  downloads   Int      @default(0)
  likes       Int      @default(0)
  createdAt   DateTime @default(now())

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  likesRel WallpaperLike[]

  @@index([userId])
  @@index([category])
  @@index([createdAt])
  @@index([downloads])
}

model WallpaperLike {
  id          String   @id @default(cuid())
  wallpaperId String
  userId      String
  createdAt   DateTime @default(now())

  wallpaper Wallpaper @relation(fields: [wallpaperId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([wallpaperId, userId])
  @@index([wallpaperId])
}

// ── Anime Bingo ──

model BingoCard {
  id        String   @id @default(cuid())
  userId    String
  title     String
  season    String   // "WINTER", "SPRING", "SUMMER", "FALL"
  year      Int
  squares   String   @default("[]") // JSON array of 25 squares
  templateId String? // optional BingoTemplate the card was generated from
  createdAt DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  template BingoTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([season, year])
  @@index([templateId])
}

model BingoTemplate {
  id          String   @id @default(cuid())
  title       String
  emoji       String   @default("🎱")
  description String?
  squares     String   @default("[]") // JSON: flat pool of { text, category, color }
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  usesCount   Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator User        @relation("BingoTemplateCreator", fields: [createdById], references: [id], onDelete: Cascade)
  cards   BingoCard[]

  @@index([createdById])
  @@index([isActive, isFeatured])
}

// ── Collaborative Watchlists ──

model SharedWatchlist {
  id          String   @id @default(cuid())
  title       String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User                   @relation("WatchlistOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members SharedWatchlistMember[]
  items   SharedWatchlistItem[]

  @@index([ownerId])
}

model SharedWatchlistMember {
  id             String   @id @default(cuid())
  watchlistId    String
  userId         String
  role           String   @default("member") // owner, editor, viewer
  joinedAt       DateTime @default(now())

  watchlist SharedWatchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, userId])
  @@index([watchlistId])
  @@index([userId])
}

model SharedWatchlistItem {
  id          String   @id @default(cuid())
  watchlistId String
  mediaId     Int
  mediaTitle  String
  mediaImage  String?
  addedBy     String
  note        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  watchlist SharedWatchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, mediaId])
  @@index([watchlistId])
}

// ── Donation / Tip System ──

model CreatorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  displayName     String?
  bio             String?
  kofiUrl         String?
  buymeacoffeeUrl String?
  upiId           String?
  totalTips       Int      @default(0)
  createdAt       DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tips  Tip[]
}

model Tip {
  id        String   @id @default(cuid())
  creatorId String
  senderId  String?
  amount    Int      // in paise/cents
  currency  String   @default("INR")
  message   String?
  anonymous Boolean  @default(false)
  createdAt DateTime @default(now())

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  sender  User?          @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([creatorId])
  @@index([createdAt])
}

// ── Anime Wordle ──

model WordleGame {
  id        String   @id @default(cuid())
  userId    String
  mediaId   Int
  mediaTitle String
  attempts  Int      @default(0)
  won       Boolean  @default(false)
  guesses   String   @default("[]") // JSON array of guessed titles
  completed Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, createdAt])
  @@index([userId])
}

// ── Profile Frames ──

model ProfileFrame {
  id          String   @id @default(cuid())
  name        String
  imageUrl    String
  rarity      String   @default("common") // common, rare, epic, legendary
  category    String   @default("default")
  unlockCondition String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  users UserFrame[]
}

model UserFrame {
  id        String   @id @default(cuid())
  userId    String
  frameId   String
  isActive  Boolean  @default(false)
  unlockedAt DateTime @default(now())

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  frame ProfileFrame  @relation(fields: [frameId], references: [id], onDelete: Cascade)

  @@unique([userId, frameId])
  @@index([userId])
}

// ── Webhook Support (API) ──

model Webhook {
  id        String   @id @default(cuid())
  userId    String
  url       String
  events    String   @default("[]") // JSON array of event types
  secret    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([userId])
  @@index([isActive])
}

model WebhookDelivery {
  id        String   @id @default(cuid())
  webhookId String
  event     String
  payload   String
  status    String   @default("pending") // pending, success, failed
  response  String?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([status])
}

// ── Scene / Clip Collector ──

model SceneClip {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  imageUrl    String
  videoUrl    String?
  mediaTitle  String?
  mediaId     Int?
  timestamp   String?  // "23:45" format
  tags        String   @default("")
  likes       Int      @default(0)
  views       Int      @default(0)
  createdAt   DateTime @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  likesRel SceneClipLike[]

  @@index([userId])
  @@index([createdAt])
  @@index([likes])
}

model SceneClipLike {
  id       String   @id @default(cuid())
  clipId   String
  userId   String
  createdAt DateTime @default(now())

  clip SceneClip @relation(fields: [clipId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clipId, userId])
  @@index([clipId])
}

// ── Commission Marketplace ──

model Commission {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String
  imageUrl    String?
  category    String   // fanart, cosplay, music, editing, other
  priceMin    Int?     // in INR
  priceMax    Int?
  turnaround  String?  // "3-5 days", "1 week", etc.
  isActive    Boolean  @default(true)
  portfolio   String   @default("[]") // JSON array of image URLs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests CommissionRequest[]

  @@index([userId])
  @@index([category])
  @@index([isActive])
}

model CommissionRequest {
  id           String   @id @default(cuid())
  commissionId String
  requesterId  String
  message      String?
  status       String   @default("pending") // pending, accepted, completed, rejected
  createdAt    DateTime @default(now())

  commission Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  requester  User       @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([commissionId])
  @@index([requesterId])
}

// ── Anime Memes ──

model Meme {
  id          String   @id @default(cuid())
  userId      String
  title       String
  imageUrl    String
  mediaTitle  String?
  tags        String   @default("")
  upvotes     Int      @default(0)
  downvotes   Int      @default(0)
  commentCount Int     @default(0)
  createdAt   DateTime @default(now())

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes    MemeVote[]
  comments MemeComment[]

  @@index([userId])
  @@index([createdAt])
  @@index([upvotes])
}

model MemeVote {
  id        String   @id @default(cuid())
  memeId    String
  userId    String
  value     Int      // 1 or -1
  createdAt DateTime @default(now())

  meme Meme @relation(fields: [memeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([memeId, userId])
  @@index([memeId])
}

model MemeComment {
  id        String   @id @default(cuid())
  memeId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  meme Meme @relation(fields: [memeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([memeId])
}

model Product {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  image         String
  description   String?
  price         Int                 // price in paise/cents
  originalPrice Int?
  stock         Int      @default(0)
  category      String
  platform      String   @default("In-house")
  anime         String?
  affiliateUrl  String?
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orderItems OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  name      String
  image     String?
  price     Int
  quantity  Int     @default(1)

  order   Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?                @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Order {
  id             String    @id @default(cuid())
  userId         String
  status         String    @default("pending")  // pending | paid | fulfilled | cancelled
  stripeSessionId String?  @unique
  subtotal       Int
  total          Int
  currency       String    @default("inr")
  customerName   String?
  customerEmail  String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  country        String    @default("IN")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       OrderItem[]

  @@index([userId, status])
  @@index([status])
}

model ContentReport {
  id          String   @id @default(cuid())
  contentType String   // POST | COMMENT | MEME | FANART | CLIP | COSPLAY | REVIEW | LONG_REVIEW | BLOG | WIKI | FORUM_THREAD | FORUM_POST | CLUB_POST | CLUB_COMMENT | REEL_COMMENT | MOMENT | REEL
  contentId   String   // id of the reported content row
  authorId    String?  // author of the reported content
  userId      String   // reporter
  reason      String
  note        String?
  status      String   @default("PENDING")  // PENDING | RESOLVED | DISMISSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contentType, contentId, userId])
  @@index([contentType, status])
  @@index([status])
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  aiEnabled Boolean  @default(true)
  followEnabled  Boolean @default(true)
  commentEnabled Boolean @default(true)
  reviewEnabled  Boolean @default(true)
  eventEnabled   Boolean @default(true)
  systemEnabled  Boolean @default(true)
  airingEnabled  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ListImport {
  id          String   @id @default(cuid())
  userId      String
  source      String   // "mal" | "anilist"
  mediaType   String   // "ANIME" | "MANGA"
  fileName    String?
  totalEntries Int     @default(0)
  imported    Int      @default(0)
  skipped     Int      @default(0)
  errors      Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model CharacterFavorite {
  id            String   @id @default(cuid())
  userId        String
  characterId   Int
  characterName String
  characterImage String?
  kind          String   @default("favorite") // "favorite" | "waifu" | "husbando"
  rank          Int      @default(0)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
  @@index([characterId])
}

model MediaRecommendation {
  id            String   @id @default(cuid())
  fromMediaId   Int
  fromTitle     String
  fromType      String   @default("ANIME")
  toMediaId     Int
  toTitle       String
  toType        String   @default("ANIME")
  meaning       String
  userId        String
  authorUsername String?
  upvotes       Int      @default(0)
  downvotes     Int      @default(0)
  createdAt     DateTime @default(now())

  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes        MediaRecommendationVote[]

  @@index([fromMediaId])
  @@index([toMediaId])
  @@index([userId])
}

model MediaRecommendationVote {
  id             String @id @default(cuid())
  recommendationId String
  userId         String
  value          Int // 1 | -1
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendation MediaRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@unique([recommendationId, userId])
  @@index([recommendationId])
}

model EpisodeReaction {
  id        String @id @default(cuid())
  mediaId   Int
  episode   Int
  userId    String
  reaction  String // "wow" | "hype" | "cry" | "lol" | "sleep"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mediaId, episode, userId])
  @@index([mediaId, episode])
  @@index([mediaId, createdAt])
}

model CharacterTrait {
  id           String   @id @default(cuid())
  characterId  Int      @unique
  name         String
  image        String?
  ageInt       Int?
  ageLabel     String?
  gender       String?
  hairColor    String?
  eyeColor     String?
  favourites   Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@index([gender])
  @@index([hairColor])
  @@index([eyeColor])
  @@index([ageInt, gender])
}

// Daily login bonus + streak (retention #1)
model DailyLogin {
  id             String    @id @default(cuid())
  userId         String    @unique
  streak         Int       @default(0)
  lastClaimed    DateTime?
  totalClaims    Int       @default(0)
  totalXpAwarded Int       @default(0)
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([streak])
}

// Coins are the spendable half of the economy: earned from activity, spent in
// the shop (streak freezes today). Balance never goes below zero; every
// movement is mirrored in EconomyLedger.
model CoinWallet {
  id             String   @id @default(cuid())
  userId         String   @unique
  balance        Int      @default(0)
  lifetimeEarned Int      @default(0)
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Append-only audit trail for every coin and XP movement. A row records *what
// happened*; CoinWallet/UserPoints hold the derived balances. `dedupeKey`
// (unique when set) is the idempotency key so a retried claim or a replayed
// webhook cannot double-award.
model EconomyLedger {
  id           String   @id @default(cuid())
  userId       String
  currency     String // "coin" | "xp"
  amount       Int // signed: + earn, − spend
  balanceAfter Int
  reason       String
  ref          String? // e.g. the day key for DAILY_LOGIN
  dedupeKey    String? @unique
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([currency, createdAt])
}

// Streak freeze/shield tokens (earned, redeemable to protect a streak)
model StreakFreeze {
  id        String   @id @default(cuid())
  userId    String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
}

// Follow anime titles for new episode / season / news alerts
model AnimeFollow {
  id        String   @id @default(cuid())
  userId    String
  mediaId   Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
  @@index([mediaId])
}

// Weekly community content contests (meme / cosplay / fanart etc)
enum ContentContestType {
  MEME
  COSPLAY
  FANART
  MOMENT
  BLOG
}

model ContentContest {
  id           String            @id @default(cuid())
  title        String
  type         ContentContestType
  weekStart    DateTime
  weekEnd      DateTime
  rewardXp     Int               @default(50)
  rewardBadge  String?
  description  String?
  winnerId     String?
  status       String            @default("ACTIVE")
  createdAt    DateTime          @default(now())

  winner      User?        @relation("ContestWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  entries     ContentContestEntry[]
}

model ContentContestEntry {
  id         String   @id @default(cuid())
  contestId  String
  userId     String
  title      String
  image      String?
  caption    String?
  upvotes    Int      @default(0)
  createdAt  DateTime @default(now())

  contest ContentContest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes   ContentContestVote[]

  @@index([contestId, upvotes])
  @@unique([contestId, userId])
}

model ContentContestVote {
  id        String   @id @default(cuid())
  contestId String
  entryId   String
  userId    String
  createdAt DateTime @default(now())

  entry ContentContestEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([entryId, userId])
  @@index([contestId])
}

/// Editorial content that used to be hardcoded in `src/lib/*.ts`. Storing it in
/// the database lets maintainers add, edit or unpublish an entry without a
/// redeploy. `kind` groups entries (e.g. `"dubbed"`, `"theatrical"`), `slug` is
/// the stable key and `data` holds the serialised entry (typed on the read
/// side by `src/lib/editorial.ts`). Reads fall back to the bundled static
/// arrays whenever the table is empty, so the site never regresses to empty.
model EditorialEntry {
  id          String   @id @default(cuid())
  kind        String
  slug        String
  title       String
  data        Json
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([kind, slug])
  @@index([kind, isPublished, sortOrder])
}
